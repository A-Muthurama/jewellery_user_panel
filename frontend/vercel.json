{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jewellery-user-panel-1.onrender.com/api/:path*"
    },
    {
      "source": "/(robots.txt|sitemap.xml)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
